<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Customer - Farm2Home</title><link rel="stylesheet" href="/styles.css"></head><body>
<nav><h2>🌾 Farm2Home</h2><ul><li><a href="/dashboard">Shop</a></li><li><a href="/logout">Logout</a></li></ul></nav>
<div class="container"><div class="topbar"><div><h1>Welcome, <%= currentUser.name %></h1><p>Choose fresh products from local farmers.</p></div><form class="search" action="/dashboard" method="GET"><input name="search" value="<%= search %>" placeholder="Search vegetables, fruits..."><button>Search</button></form></div>
<h2>Available Products</h2><div class="grid">
<% if(!products.length){ %><div class="card"><p>No matching products found.</p></div><% } %>
<% products.forEach(p=>{ %><div class="card product-card"><h3><%= p.name %></h3><p><span class="badge"><%= p.category %></span></p><p>By <%= p.farmer ? p.farmer.name : "Farmer" %></p><p class="price">₹<%= p.price.toFixed(2) %> / <%= p.unit %></p><p><%= p.description %></p><p>Stock: <%= p.quantityAvailable %> <%= p.unit %></p><form action="/orders" method="POST"><input type="hidden" name="productId" value="<%= p._id %>"><label>Quantity</label><input type="number" name="quantity" min="1" max="<%= p.quantityAvailable %>" value="1" required><label>Delivery Address</label><textarea name="deliveryAddress" required><%= currentUser.address || "" %></textarea><label>Phone</label><input name="phone" value="<%= currentUser.phone || "" %>" required><button class="btn-orange">Order Now</button></form></div><% }) %></div>
<h2 style="margin-top:35px">My Orders</h2><% if(!orders.length){ %><div class="card"><p>No orders yet.</p></div><% } else { orders.forEach(o=>{ %><div class="order-card"><div class="topbar"><div><h3>Order #<%= o._id.toString().slice(-8) %></h3><p>Total: <strong>₹<%= o.totalAmount.toFixed(2) %></strong></p></div><span class="badge"><%= o.status %></span></div><p><%= o.items.map(i=>i.productName+" × "+i.quantity+" "+i.unit).join(", ") %></p><a class="btn" href="/orders/<%= o._id %>">View Order</a><% if(["Pending","Confirmed"].includes(o.status)){ %><form style="display:inline" action="/orders/<%= o._id %>/cancel" method="POST"><button class="btn-danger">Cancel</button></form><% } %></div><% })} %>
</div></body></html>