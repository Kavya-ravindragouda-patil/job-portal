<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order - Farm2Home</title><link rel="stylesheet" href="/styles.css"></head><body><nav><h2>🌾 Farm2Home</h2><a href="/dashboard">Dashboard</a></nav><div class="container"><div class="order-card"><div class="topbar"><h1>Order #<%= order._id.toString().slice(-8) %></h1><span class="badge"><%= order.status %></span></div><h2>Items</h2><% order.items.forEach(i=>{ %><p><strong><%= i.productName %></strong> — <%= i.quantity %> <%= i.unit %> × ₹<%= i.price.toFixed(2) %> = ₹<%= i.subtotal.toFixed(2) %></p><% }) %><hr style="margin:18px 0"><p><strong>Total:</strong> ₹<%= order.totalAmount.toFixed(2) %></p><p><strong>Delivery Address:</strong> <%= order.deliveryAddress %></p><p><strong>Phone:</strong> <%= order.phone %></p><p><strong>Ordered:</strong> <%= new Date(order.orderedAt).toLocaleString() %></p><% if(order.deliveryPerson){ %><p><strong>Delivery Partner:</strong> <%= order.deliveryPerson.name %> (<%= order.deliveryPerson.phone %>)</p><% } %><a class="btn" href="/dashboard">Back to Dashboard</a></div></div></body></html>