<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Add Product - Farm2Home</title><link rel="stylesheet" href="/styles.css"></head><body><nav><h2>🌾 Farm2Home</h2><a href="/dashboard">Dashboard</a></nav><div class="form-card"><h1>Add Farm Product</h1><% if(error){ %><div class="card"><%= error %></div><% } %><form action="/products" method="POST"><label>Product Name</label><input name="name" placeholder="Tomato" required><label>Category</label><input name="category" placeholder="Vegetables" required><label>Price (₹)</label><input type="number" name="price" min="0" step="0.01" required><label>Unit</label><select name="unit"><option>kg</option><option>piece</option><option>dozen</option><option>litre</option></select><label>Available Quantity</label><input type="number" name="quantityAvailable" min="0" step="1" required><label>Description</label><textarea name="description" required></textarea><label>Image URL (optional)</label><input name="imageUrl" placeholder="https://..."><button type="submit">Add Product</button></form></div></body></html>