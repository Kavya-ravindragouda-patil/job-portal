<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farmer - Farm2Home</title><link rel="stylesheet" href="/styles.css"></head><body>
<nav><h2>🌾 Farm2Home</h2><ul><li><a href="/dashboard">Dashboard</a></li><li><a href="/products/new">Add Product</a></li><li><a href="/logout">Logout</a></li></ul></nav>
<div class="container"><div class="topbar"><div><h1>Farmer Dashboard</h1><p>Welcome, <%= currentUser.name %>. Manage your farm products and orders.</p></div><a class="btn" href="/products/new">+ Add Product</a></div>
<h2>Your Products</h2><div class="grid"><% if(!products.length){ %><div class="card"><p>No products added yet.</p></div><% } %><% products.forEach(p=>{ %><div class="card"><h3><%= p.name %></h3><p><%= p.category %> · ₹<%= p.price.toFixed(2) %>/<%= p.unit %></p><p>Stock: <%= p.quantityAvailable %> <%= p.unit %></p><p><span class="badge"><%= p.active ? "Active" : "Hidden" %></span></p><form action="/products/<%= p._id %>/toggle" method="POST"><button><%= p.active ? "Hide Product" : "Show Product" %></button></form></div><% }) %></div>
<h2 style="margin-top:35px">Customer Orders</h2><% if(!orders.length){ %><div class="card"><p>No orders for your products yet.</p></div><% } else { orders.forEach(o=>{ %><div class="order-card"><div class="topbar"><div><h3>Order #<%= o._id.toString().slice(-8) %></h3><p>Customer: <%= o.customer ? o.customer.name : "Customer" %> · <%= o.phone || (o.customer && o.customer.phone) || "" %></p></div><span class="badge"><%= o.status %></span></div><p><%= o.items.filter(i=>i.farmer.toString()===currentUser.id).map(i=>i.productName+" × "+i.quantity+" "+i.unit).join(", ") %></p><p>Delivery: <%= o.deliveryAddress %></p><div class="actions"><a class="btn" href="/orders/<%= o._id %>">View</a><% if(o.status==="Pending"){ %><form action="/orders/<%= o._id %>/status" method="POST"><input type="hidden" name="status" value="Confirmed"><button>Confirm</button></form><% } %><% if(o.status==="Confirmed"){ %><form action="/orders/<%= o._id %>/status" method="POST"><input type="hidden" name="status" value="Packed"><button>Mark Packed</button></form><% } %><% if(o.status==="Packed"){ %><form action="/orders/<%= o._id %>/status" method="POST"><input type="hidden" name="status" value="Out for Delivery"><button class="btn-orange">Send for Delivery</button></form><% } %></div></div><% })} %>
</div></body></html>